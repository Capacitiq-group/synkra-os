# ===========================================================================
# CANONICAL ENVIRONMENT VARIABLES - synkra-os
# Copy to .env and fill in real values before deploying.
# Nothing in this file is a real credential.
# Canonical names are primary. Legacy names are kept as working fallbacks
# for ONE deploy cycle only, then removed.
# ===========================================================================

# --- Shared PocketBase instance -------------------------------------------
# CANONICAL (server-only)
SYNKRA_PB_URL=https://<shared-instance-host>
# This app's own public base URL (not shared with other apps)
SYNKRA_APP_URL=https://<synkra-os-host>

# --- Resend (transactional email) - synkra-os ONLY ------------------------
# Used by pb_hooks/email_adapter.pb.js, incl. the accept-invite email sent
# from POST /api/agency-platform/invites. The invite link is built from
# SYNKRA_APP_URL above.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
# Shared secret Resend/Svix signs webhook deliveries with.
RESEND_WEBHOOK_SECRET=

# --- Payment provider (Paystack) ------------------------------------------
# Gates: POST /api/payments/:id/refund
PAYSTACK_SECRET_KEY=

# --- Per-service tokens (one per consumer, never shared) ------------------
# Python AI worker - Implementation AI internal employees.
# One token per employee; the same variable name must exist in the calling
# app (implementation-ai) and in this validating app.
AI_WORKER_API_KEY=
AI_WORKER_API_KEY_CUSTOMER_SUPPORT=
# Direct Acquisition Engine (separate project)
ACQUISITION_WORKER_API_KEY=

# --- Synkra Flow (read-only service account) ------------------------------
FLOW_API_BASE=
FLOW_API_KEY=

# --- Coolify (infrastructure monitoring) ----------------------------------
COOLIFY_API_BASE=
COOLIFY_API_TOKEN=

# --- Synkra Chat product API ----------------------------------------------
CHAT_API_BASE=
CHAT_API_KEY=

# --- Zoho Books (invoice sync) --------------------------------------------
ZOHO_BOOKS_API_KEY=

# --- Agency pricing-exception gate ----------------------------------------
# Amount in cents (USD). Example: 500000 = $5,000.00
AGENCY_STANDARD_PRICING_CEILING_CENTS=

# --- Agency Platform (RETIRED) --------------------------------------------
# The "Agency Platform" is now the SAME PocketBase instance as SYNKRA_PB_URL,
# so these are no longer needed. agency_platform_adapter.pb.js should read
# SYNKRA_PB_URL and this app's own service account instead.
# LEGACY FALLBACK - remove after one deploy cycle.
AGENCY_PLATFORM_PB_BASE_URL=
AGENCY_PLATFORM_PB_TOKEN=

# --- PocketBase superuser bootstrap (first run only) ----------------------
BOOTSTRAP_ADMIN_EMAIL=admin@synkra.example
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-first-run
