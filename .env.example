# Copy to .env and fill in real values before deploying.
# Nothing in this file is a real credential.

# --- Payment provider (Paystack) -----------------------------------------
# Gates: POST /api/payments/:id/refund
# Without this set, refund attempts return 501 (integration not connected)
# rather than a fake success.
PAYSTACK_SECRET_KEY=

# --- Synkra Flow (real PocketBase backend, per the Flow handover doc) -----
# Gates: /api/flow/* read routes (users, workspaces, billing-*, etc.)
# FLOW_API_BASE = Flow's PocketBase URL (e.g. https://pb.synkra.co.za)
# FLOW_API_KEY  = a bearer token for a DEDICATED SERVICE ACCOUNT in Flow's
#                 own `users` collection — per the handover doc, this must
#                 NOT be the same credential a human uses to log into
#                 Flow's PocketBase admin UI. Read-only access is all this
#                 needs (Channel A in the handover doc).
# NOTE: suspend/reactivate/impersonate/magic-link (Channel B — actions) are
# NOT gated by these — they always return 501 right now because the
# corresponding synkra-core admin endpoints don't exist yet. Setting these
# only enables reads.
FLOW_API_BASE=
FLOW_API_KEY=

# --- Coolify (infrastructure monitoring) -----------------------------------
# Gates: POST /api/infrastructure/sync-coolify and the 5-minute background
# sync. COOLIFY_API_BASE = your Coolify instance URL. COOLIFY_API_TOKEN =
# a token from Coolify's Keys & Tokens screen. Works uniformly across
# different backing databases (PocketBase, PostgreSQL, etc.) since it
# reports container/resource status, not database-specific internals.
# CPU/RAM/disk percentages only populate if Coolify's Sentinel agent is
# enabled per-server — see pb_hooks/coolify_adapter.pb.js for the caveat.
COOLIFY_API_BASE=
COOLIFY_API_TOKEN=

# --- Synkra Chat product API ----------------------------------------------
# No Chat backend has been identified yet (see README) — leave unset until
# one exists. Setting CHAT_API_BASE without a matching adapter
# implementation in pb_hooks/chat_adapter.pb.js will report "unavailable".
CHAT_API_BASE=
CHAT_API_KEY=

# --- Zoho Books (invoice sync) --------------------------------------------
ZOHO_BOOKS_API_KEY=

# --- Agency pricing-exception gate ----------------------------------------
# Gates: the manual-review requirement in
# pb_hooks/agency_transitions.pb.js. A quote above this amount (in cents,
# USD) cannot proceed past the "quotation" stage without an explicit
# manual_review_cleared_by. This is a business decision Synkra needs to
# set — left unset, the gate is effectively off (no ceiling enforced).
# Example: 500000 = $5,000.00
AGENCY_STANDARD_PRICING_CEILING_CENTS=

# --- Python AI worker (AI Employees job execution) -------------------------
# Gates: POST /api/ai-jobs/:id/result. A static bearer token the Python
# worker sends — this is a service credential, not an employee session.
AI_WORKER_API_KEY=

# --- Resend (transactional email) ------------------------------------------
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
# Shared secret Resend/Svix signs webhook deliveries with. See the honesty
# note in pb_hooks/email_adapter.pb.js — presence is checked, full HMAC
# verification per Svix's spec is not yet implemented.
RESEND_WEBHOOK_SECRET=

# --- Direct Acquisition Engine (separate Python/AI-agent project) ----------
# Gates every /api/acquisition/* ingestion route. This project (discovery
# bots, research agents, outreach generation) does not exist in this
# codebase — it is a separate repository per the architecture spec. Set
# this once that project is built and needs to write into this CRM.
ACQUISITION_WORKER_API_KEY=

# --- Agency Platform (the dedicated Agency PocketBase instance) -----------
# Per ARCHITECTURE.md: a separate PocketBase instance the Client Portal
# already writes to. Synkra OS acts as the "Admin Panel" role against it.
# AGENCY_PLATFORM_PB_TOKEN must be a bearer token for a DEDICATED,
# non-superuser service account on that instance — per that document's own
# instruction, not the Client Portal's POCKETBASE_ADMIN_EMAIL/PASSWORD.
AGENCY_PLATFORM_PB_BASE_URL=
AGENCY_PLATFORM_PB_TOKEN=

# --- PocketBase superuser bootstrap (first run only) ----------------------
# Used only by scripts/bootstrap.sh to create the first Super Administrator
# login. Not read by the application at runtime.
BOOTSTRAP_ADMIN_EMAIL=admin@synkra.example
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-first-run
